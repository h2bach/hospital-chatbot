# Copy to .env and replace placeholders. Never commit .env.

# FPT is mandatory for planning, grounded synthesis and evaluation.
LLM_PROVIDERS=fpt
FPT_API_KEYS=your_fpt_api_key_here
FPT_MODEL=your_fpt_chat_model_here
# Required only when visitors can attach images.
FPT_VLM_MODEL=your_fpt_vision_model_here
# Optional speech-to-text model. Leave empty to disable microphone transcription.
FPT_STT_MODEL=
# Optional; defaults to https://mkp-api.fptcloud.com
# FPT_BASE_URL=https://mkp-api.fptcloud.com

# Optional development fallback; production compose forces LLM_PROVIDERS=fpt.
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-model-name

# Direct-host endpoints. Docker Compose overrides them with internal addresses.
RAG_SERVICE_URL=http://localhost:6690
MCP_SERVICE_URL=http://localhost:6689/mcp
HOSPITAL_INFO_SERVICE_URL=http://localhost:8081
ORCHESTRATOR_MODE=unified

# Retrieval mode. The default docker-compose.yml forces cpu; the GPU overlay
# forces gpu and supplies the internal dense URL. These values are useful when
# running rag-core directly outside Compose.
RAG_RETRIEVAL_MODE=cpu
DENSE_RETRIEVAL_URL=

# Optional GPU dense retrieval (internal only; no public port is opened).
HEARTCARE_BGE_M3_CACHE_PATH=/path/to/local/hf-cache/hub/models--BAAI--bge-m3
HEARTCARE_BGE_M3_REVISION=5617a9f61b028005a4858fdac845db406aefb181

# Public application settings.
PORT=6689
# Optional absolute URL used by the admin dashboard's "Mở chatbot" link.
# When empty, the dashboard uses its current hostname with public port 6689.
PUBLIC_CHATBOT_URL=
AGENT_STATIC_DIR=./ai-agent/static
ASSISTANT_NAME=Trợ lý Tim Hà Nội
HOTLINE=1900 1082
EMERGENCY_HOTLINE=115
EMERGENCY_ADDRESS=
BOOKING_WEBSITE=https://benhvientimhanoi.vn
ZALO_APP_NAME=Bệnh viện Tim Hà Nội
ZALO_APP_LINK=https://zalo.me/s/hanoiheart
