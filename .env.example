# === App ===
APP_NAME=AI Service
APP_VERSION=1.0.0
DEBUG=true

# === Ollama (local, free) ===
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# === Google GenAI / Gemini ===
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-2.0-flash-exp

# === OpenAI ===
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# === Other Provider (OpenAI-compatible: shopaikey, etc.) ===
OTHER_API_KEY=your-shopaikey-api-key-here
OTHER_BASE_URL=https://api.shopaikey.com/v1
OTHER_MODEL=gpt-5.4-mini-2026-03-17

# === Shared LLM Settings ===
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=30

# Note: Tier configuration (cheap/middle/strong) is defined in code (llm_factory.py),
# not in .env. Only model names and API keys are configured here.
# Each tier automatically uses fallback models if primary fails.

# === Data Ingestion ===
# Vector store configuration (pinecone | weaviate | qdrant | chroma)
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_URL=http://localhost:8001
VECTOR_STORE_API_KEY=

# Ingestion settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
BATCH_SIZE=100
MAX_CONCURRENT_REQUESTS=5

# Backend API settings
BACKEND_API_TIMEOUT=60
BACKEND_API_RETRY_COUNT=3

# === Server ===
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
