# HeartCare AI Hospital Chatbot Local Environment Configuration
# Copy this file to '.env' and fill in your actual API keys.
# Do NOT commit '.env' to git repository (configured in .gitignore).

# Gemini API Key (get from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_actual_gemini_api_key_here

# FPT AI Inference (use a VLM model for image messages)
# FPT_MODEL=your_text_model_name
# FPT_VLM_MODEL=your_vision_model_name

# Official booking channels
# BOOKING_WEBSITE=https://example.invalid/booking
# ZALO_APP_NAME=Bệnh viện Tim Hà Nội
# ZALO_APP_LINK=https://zalo.me/s/your-mini-app
