# HeartCare AI Hospital Chatbot Local Environment Configuration
# Copy this file to '.env' and fill in your actual API keys.
# Do NOT commit '.env' to git repository (configured in .gitignore).

# FPT is mandatory for planning, grounded synthesis and evaluation.
LLM_PROVIDERS=fpt
FPT_API_KEYS=your_fpt_api_key_here
FPT_MODEL=your_fpt_chat_model_here
# Optional; defaults to https://mkp-api.fptcloud.com
# FPT_BASE_URL=https://mkp-api.fptcloud.com

# Docker Compose overrides these with internal service addresses. These values
# are useful only when the services are run directly on the host.
RAG_SERVICE_URL=http://localhost:6690
MCP_SERVICE_URL=http://localhost:6689/mcp
HOSPITAL_INFO_SERVICE_URL=http://localhost:8081
ORCHESTRATOR_MODE=unified

# GPU dense retrieval (internal only; no public port is opened).
# Override when the local BGE-M3 snapshot is stored elsewhere.
HEARTCARE_BGE_M3_CACHE_PATH=/path/to/local/hf-cache/hub/models--BAAI--bge-m3
HEARTCARE_BGE_M3_REVISION=5617a9f61b028005a4858fdac845db406aefb181

# Public application settings
PORT=6689
AGENT_STATIC_DIR=./ai-agent/static
ASSISTANT_NAME=Trợ lý Tim Hà Nội
HOTLINE=
EMERGENCY_ADDRESS=
EMERGENCY_HOTLINE=115
BOOKING_WEBSITE=
ZALO_APP_NAME=
