# === App Configuration ===
APP_NAME=AI Service
APP_VERSION=1.0.0
DEBUG=false

# === Ollama (local, free) ===
# Only needed when any tier uses provider="ollama"
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# === Google GenAI / Gemini ===
# Last-resort fallback for all tiers
GOOGLE_API_KEY=your-google-api-key-here
GOOGLE_MODEL=gemini-2.0-flash-exp

# === OpenAI ===
# Optional, if using official OpenAI API
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# === Other Provider (OpenAI-compatible: shopaikey, etc.) ===
# Used when a tier's own api_key / base_url is not set
OTHER_API_KEY=your-api-key-here
OTHER_BASE_URL=https://api.shopaikey.com/v1
OTHER_MODEL=gpt-4o-mini

# === Shared LLM Settings ===
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# =============================================================================
# LLM Tier Configuration
# Each tier has: PROVIDER, NAME, API_KEY (opt), BASE_URL (opt)
# PROVIDER options: other | openai | google | ollama
# API_KEY / BASE_URL: if empty → falls back to OTHER_API_KEY / OTHER_BASE_URL
# =============================================================================

# ── Tier: strong ──────────────────────────────────────────────────────────────
# Used by: Planner Chain 1 (initial task planning, structured output, temp=0)
STRONG_MODEL_PROVIDER=other
STRONG_MODEL_NAME=gpt-4o-mini
STRONG_MODEL_API_KEY=
STRONG_MODEL_BASE_URL=

# ── Tier: middle ──────────────────────────────────────────────────────────────
# Used by: Planner Chain 2 (decision/replan), Synthesizer (temp=0)
MIDDLE_MODEL_PROVIDER=other
MIDDLE_MODEL_NAME=gpt-4o-mini
MIDDLE_MODEL_API_KEY=
MIDDLE_MODEL_BASE_URL=

# ── Tier: cheap ───────────────────────────────────────────────────────────────
# Reserved: query rewriting, intent detection, other lightweight tasks
CHEAP_MODEL_PROVIDER=other
CHEAP_MODEL_NAME=gpt-4o-mini
CHEAP_MODEL_API_KEY=
CHEAP_MODEL_BASE_URL=

# === Data Ingestion ===
# Vector store configuration
VECTOR_STORE_TYPE=chroma
VECTOR_STORE_URL=http://localhost:8001
VECTOR_STORE_API_KEY=

# Chroma (local persistent, default backend)
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=documents

# BM25 keyword index
BM25_INDEX_PATH=data/bm25.pkl

# SQLite chunk metadata store
CHUNK_DB_PATH=data/chunks.db

# Embedding configuration
EMBEDDING_API_KEY=your-api-key-here
EMBEDDING_BASE_URL=https://api.shopaikey.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Chunking parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
BATCH_SIZE=100
MAX_CONCURRENT_REQUESTS=5

# Backend API settings
BACKEND_API_TIMEOUT=60
BACKEND_API_RETRY_COUNT=3

# === Server ===
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
