FROM python:3.13-slim

WORKDIR /app
ENV PYTHONPATH=/app/rag-core PYTHONUNBUFFERED=1

COPY rag-core/rag_core /app/rag-core/rag_core
COPY docs/data_rag /app/source-data
COPY ai-agent/static /app/static

RUN python -m rag_core.indexing --source-dir /app/source-data --output-dir /app/data-rag

EXPOSE 6689

CMD ["python", "-m", "rag_core.app", "--host", "0.0.0.0", "--port", "6689", "--chunks", "/app/data-rag/chunks.jsonl", "--documents", "/app/data-rag/documents.jsonl", "--knowledge-manifest", "/app/source-data/knowledge_sources.json", "--static", "/app/static"]
